<?xml version="1.0"?>
<interfaceDefinition>
  <node name="service">
    <children>
      <node name="cloud" owner="${vyos_conf_scripts_dir}/service_cloud.py">
        <children>
          <leafNode name="registration">
            <properties>
              <help>Cloud registration code</help>
              <valueHelp>
                <format>123456</format>
                <description>6-digit registration code provided by PerleCloud</description>
              </valueHelp>
              <constraint>
                <validator name="numeric" argument="--range 100000-999999"/>
              </constraint>
            </properties>
          </leafNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
