<?xml version="1.0"?>
<interfaceDefinition>
  <node name="system">
    <children>
      <node name="config-management" owner="${vyos_conf_scripts_dir}/system_config-management.py">
        <properties>
          <help>Configuration management settings</help>
          <priority>400</priority>
        </properties>
        <children>
          <node name="commit-archive">
            <properties>
              <help>Commit archive settings</help>
            </properties>
            <children>
              <tagNode name="location">
                <properties>
                  <help>Commit archive location</help>
                  <valueHelp>
                    <format>txt</format>
                    <description>Name of the commit archive location</description>
                  </valueHelp>
                </properties>
                <children>
                  <node name="scp">
                    <properties>
                      <help>Archive configuration using SCP</help>
                    </properties>
                    <children>
                      #include <include/config-management/remote-auth.xml.i>
                    </children>
                  </node>
                  <node name="sftp">
                    <properties>
                      <help>Archive configuration using SFTP</help>
                    </properties>
                    <children>
                      #include <include/config-management/remote-auth.xml.i>
                    </children>
                  </node>
                  <node name="ssh">
                    <properties>
                      <help>Archive configuration using SSH</help>
                    </properties>
                    <children>
                      #include <include/config-management/remote-auth.xml.i>
                    </children>
                  </node>
                  <node name="ftp">
                    <properties>
                      <help>Archive configuration using FTP</help>
                    </properties>
                    <children>
                      #include <include/config-management/remote-auth.xml.i>
                    </children>
                  </node>
                  <node name="ftps">
                    <properties>
                      <help>Archive configuration using FTP over TLS</help>
                    </properties>
                    <children>
                      #include <include/config-management/remote-auth.xml.i>
                    </children>
                  </node>
                  <node name="http">
                    <properties>
                      <help>Archive configuration using HTTP</help>
                    </properties>
                    <children>
                      #include <include/config-management/remote-auth.xml.i>
                    </children>
                  </node>
                  <node name="https">
                    <properties>
                      <help>Archive configuration using HTTPS</help>
                    </properties>
                    <children>
                      #include <include/config-management/remote-auth.xml.i>
                    </children>
                  </node>
                  <node name="git">
                    <properties>
                      <help>Archive configuration using git</help>
                    </properties>
                    <children>
                      <leafNode name="transport">
                        <properties>
                          <help>Transport used to reach the git remote</help>
                          <completionHelp>
                            <list>https http ssh</list>
                          </completionHelp>
                          <valueHelp>
                            <format>https</format>
                            <description>Push over HTTPS</description>
                          </valueHelp>
                          <valueHelp>
                            <format>http</format>
                            <description>Push over plain HTTP</description>
                          </valueHelp>
                          <valueHelp>
                            <format>ssh</format>
                            <description>Push over SSH</description>
                          </valueHelp>
                          <constraint>
                            <regex>(https|http|ssh)</regex>
                          </constraint>
                        </properties>
                      </leafNode>
                      #include <include/config-management/remote-auth.xml.i>
                    </children>
                  </node>
                  <node name="tftp">
                    <properties>
                      <help>Archive configuration using TFTP</help>
                    </properties>
                    <children>
                      #include <include/config-management/remote.xml.i>
                    </children>
                  </node>
                </children>
              </tagNode>
              #include <include/source-address-ipv4-ipv6.xml.i>
              #include <include/interface/vrf.xml.i>
            </children>
          </node>
          <leafNode name="commit-revisions">
            <properties>
              <help>Commit revisions</help>
              <valueHelp>
                <format>u32:1-65535</format>
                <description>Number of config backups to keep</description>
              </valueHelp>
              <constraint>
                <validator name="numeric" argument="--range 1-65535"/>
              </constraint>
              <constraintErrorMessage>Number of revisions must be between 0 and 65535</constraintErrorMessage>
            </properties>
          </leafNode>
          <node name="commit-confirm">
            <properties>
              <help>Commit confirm options</help>
            </properties>
            <children>
              <leafNode name="action">
                <properties>
                  <help>Commit confirm revert action</help>
                  <completionHelp>
                    <list>reload reboot</list>
                  </completionHelp>
                  <valueHelp>
                    <format>reload</format>
                    <description>Reload previous configuration if not confirmed</description>
                  </valueHelp>
                  <valueHelp>
                    <format>reboot</format>
                    <description>Reboot to saved configuration if not confirmed</description>
                  </valueHelp>
                  <constraint>
                    <regex>(reload|reboot)</regex>
                  </constraint>
                </properties>
                <defaultValue>reboot</defaultValue>
              </leafNode>
            </children>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
