<?xml version="1.0"?>
<interfaceDefinition>
  <node name="service">
    <children>
      <tagNode name="idp" owner="${vyos_conf_scripts_dir}/service_idp.py">
        <properties>
          <priority>50</priority>
          <help>Identity provider configuration</help>
          <valueHelp>
            <format>&lt;idp-name&gt;</format>
            <description>Name of the identity provider</description>
          </valueHelp>
        </properties>
        <children>
          <leafNode name="metadata-url">
            <properties type="single">
              <help>Identity provider metadata url</help>
              <valueHelp>
                <format>https://example.com/idp</format>
                <description>Metadata URL of the identity provider</description>
              </valueHelp>
              <constraint>
                <regex>https?://.*</regex>
              </constraint>
            </properties>
          </leafNode>

          <leafListNode name="domain">
            <properties>
              <help>Domain(s) associated with this identity provider</help>
              <multi/>
              <valueHelp>
                <format>company.com</format>
                <description>Domain name (e.g., company.com)</description>
              </valueHelp>
              <constraint>
                <regex>^[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}$</regex>
              </constraint>
            </properties>
          </leafListNode>
        </children>
      </tagNode>
    </children>
  </node>
</interfaceDefinition>
