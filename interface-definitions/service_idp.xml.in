<?xml version="1.0"?>
<interfaceDefinition>
  <node name="service">
    <children>
      <tagNode name="idp" owner="${vyos_conf_scripts_dir}/service_idp.py">
        <properties>
          <priority>100</priority>
          <help>Identity provider configuration</help>
          <valueHelp>
            <format>&lt;provider-name&gt;</format>
            <description>Name of the identity provider</description>
          </valueHelp>
        </properties>
        <children>
          <leafNode name="metadata-url">
            <properties>
              <help>Identity provider metadata url</help>
              <valueHelp>
                <format>https://example.com/idp</format>
                <description>metadata url of the identity provider</description>
              </valueHelp>
            </properties>
          </leafNode>
          <leafNode name="domain">
            <properties>
              <help>Domain(s) for the identity provider</help>
              <multi/>
              <valueHelp>
                <format>example.com</format>
                <description>Domain of the identity provider</description>
              </valueHelp>
              <constraint>
                <regex>^[a-zA-Z0-9.-]+$</regex>
              </constraint>
            </properties>
          </leafNode>
          <node name="attribute">
            <properties>
              <help> Identity provider attributes</help>
            </properties>
            <children>
              <tagNode name="attr">
                <properties>
                  <help>Identity provider attribute</help>
                  <valueHelp>
                    <format>&lt;attribute-name&gt;</format>
                    <description>Name of the identity provider attribute</description>
                  </valueHelp>
                </properties>
                <children>
                  <leafNode name="value">
                    <properties>
                      <help>Value of the attribute</help>
                      <multi/>
                      <valueHelp>
                        <format>&lt;attribute-value&gt;</format>
                        <description>Allowed value(s) of the identity provider attribute</description>
                      </valueHelp>
                    </properties>
                  </leafNode>
                </children>
              </tagNode>
            </children>
          </node>
          <leafNode name="user">
            <properties>
              <help>Allowed users for the identity provider</help>
              <multi/>
              <valueHelp>
                <format>&lt;username&gt;</format>
                <description>Username of the allowed user</description>
              </valueHelp>
            </properties>
          </leafNode>
        </children>
      </tagNode>
    </children>
  </node>
</interfaceDefinition>
