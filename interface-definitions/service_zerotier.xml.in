<?xml version="1.0"?>
<interfaceDefinition>
  <node name="service">
    <properties>
      <help>System services</help>
    </properties>
    <children>
      <node name="zerotier" owner="${vyos_conf_scripts_dir}/service_zerotier.py">
        <properties>
          <help>ZeroTier service</help>
          <priority>280</priority>
        </properties>
        <children>
          <node name="identity">
            <properties>
              <help>ZeroTier node identity</help>
            </properties>
            <children>
              <leafNode name="secret">
                <properties>
                  <help>Full ZeroTier identity.secret value</help>
                  <constraint>
                    <regex>^[0-9a-f]{10}:[0-9]+:[A-Za-z0-9+/=]+:[A-Za-z0-9+/=]+$</regex>
                  </constraint>
                  <constraintErrorMessage>Identity must be a full ZeroTier identity.secret string</constraintErrorMessage>
                </properties>
              </leafNode>
            </children>
          </node>
          <leafNode name="listen-address">
            <properties>
              <help>Address for ZeroTier to bind</help>
              <constraint>
                <validator name="ip-address"/>
              </constraint>
              <multi/>
            </properties>
          </leafNode>
          <node name="port">
            <properties>
              <help>ZeroTier UDP ports</help>
            </properties>
            <children>
              <leafNode name="primary">
                <properties>
                  <help>Primary UDP port</help>
                  <constraint>
                    <validator name="numeric" argument="--range 1-65535"/>
                  </constraint>
                </properties>
                <defaultValue>9993</defaultValue>
              </leafNode>
              <leafNode name="secondary">
                <properties>
                  <help>Secondary UDP port</help>
                  <constraint>
                    <validator name="numeric" argument="--range 1-65535"/>
                  </constraint>
                </properties>
              </leafNode>
              <leafNode name="tertiary">
                <properties>
                  <help>Tertiary UDP port</help>
                  <constraint>
                    <validator name="numeric" argument="--range 1-65535"/>
                  </constraint>
                </properties>
              </leafNode>
            </children>
          </node>
          <leafNode name="disable-port-mapping">
            <properties>
              <help>Disable UPnP and NAT-PMP port mapping</help>
              <valueless/>
            </properties>
          </leafNode>
          <leafNode name="disable-secondary-port">
            <properties>
              <help>Disable the secondary UDP port</help>
              <valueless/>
            </properties>
          </leafNode>
          <leafNode name="disable-tcp-fallback">
            <properties>
              <help>Disable TCP fallback relay use</help>
              <valueless/>
            </properties>
          </leafNode>
          <leafNode name="force-tcp-relay">
            <properties>
              <help>Force TCP relay use</help>
              <valueless/>
            </properties>
          </leafNode>
          <leafNode name="interface-blacklist">
            <properties>
              <help>Interface name prefix ZeroTier must not bind to</help>
              <valueHelp>
                <format>prefix</format>
                <description>Interface prefix</description>
              </valueHelp>
              <multi/>
            </properties>
          </leafNode>
          <node name="multicore">
            <properties>
              <help>ZeroTier multicore processing</help>
            </properties>
            <children>
              <leafNode name="enable">
                <properties>
                  <help>Enable multicore processing</help>
                  <valueless/>
                </properties>
              </leafNode>
              <leafNode name="core-count">
                <properties>
                  <help>Number of worker cores</help>
                  <constraint>
                    <validator name="numeric" argument="--range 2-1024"/>
                  </constraint>
                </properties>
              </leafNode>
              <leafNode name="cpu-pinning">
                <properties>
                  <help>Pin ZeroTier worker threads to CPUs</help>
                  <valueless/>
                </properties>
              </leafNode>
            </children>
          </node>
          <leafNode name="tcp-relay">
            <properties>
              <help>TCP relay address and port</help>
              <constraint>
                <validator name="ip-port"/>
              </constraint>
            </properties>
          </leafNode>
          <tagNode name="moon">
            <properties>
              <help>Orbit a ZeroTier moon</help>
              <constraint>
                <regex>^[A-Fa-f0-9]{16}$</regex>
              </constraint>
              <constraintErrorMessage>Moon ID must be a 16-digit hexadecimal value</constraintErrorMessage>
            </properties>
            <children>
              <leafNode name="seed">
                <properties>
                  <help>Moon seed node ID</help>
                  <constraint>
                    <regex>^[A-Fa-f0-9]{10}$</regex>
                  </constraint>
                  <constraintErrorMessage>Moon seed must be a 10-digit ZeroTier node ID</constraintErrorMessage>
                </properties>
              </leafNode>
            </children>
          </tagNode>
          <tagNode name="peer">
            <properties>
              <help>Static peer path hints</help>
              <constraint>
                <regex>^[A-Fa-f0-9]{10}$</regex>
              </constraint>
              <constraintErrorMessage>Peer must be a 10-digit ZeroTier node ID</constraintErrorMessage>
            </properties>
            <children>
              <leafNode name="path">
                <properties>
                  <help>Peer path hint</help>
                  <constraint>
                    <validator name="ip-port"/>
                  </constraint>
                  <multi/>
                </properties>
              </leafNode>
            </children>
          </tagNode>
          <tagNode name="physical">
            <properties>
              <help>Physical path policy</help>
              <constraint>
                <validator name="ip-prefix"/>
              </constraint>
            </properties>
            <children>
              <leafNode name="blacklist">
                <properties>
                  <help>Prevent ZeroTier from using this physical path</help>
                  <valueless/>
                </properties>
              </leafNode>
              <leafNode name="mtu">
                <properties>
                  <help>UDP payload MTU for this physical path</help>
                  <constraint>
                    <validator name="numeric" argument="--range 576-9000"/>
                  </constraint>
                </properties>
              </leafNode>
            </children>
          </tagNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
