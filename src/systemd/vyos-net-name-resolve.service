[Unit]
Description=VyOS persistent interface naming
Documentation=man:vyos-net-name-resolve.py(8)

# Started by vyos-router once the config directory is mounted - for an
# encrypted volume that is only after it has been unlocked - so this can not
# be ordered independently. Started again for hot-plugged hardware, hence no
# RemainAfterExit, which would make every later start a no-op.
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/usr/libexec/vyos/system/vyos-net-name-resolve.py
TimeoutStartSec=90
StandardOutput=journal+console
