# T9329: The InfluxDB output used to unconditionally skip verification of the
# remote server certificate (`insecure_skip_verify = true`). Certificate
# verification is now enabled by default and can be configured via the new
# 'tls' node. Preserve the previous behavior for existing HTTPS endpoints by
# explicitly setting 'tls insecure'.

from vyos.configtree import ConfigTree

base = ['service', 'monitoring', 'telegraf', 'influxdb']


def migrate(config: ConfigTree) -> None:
    url_path = base + ['url']
    if not config.exists(url_path):
        # Nothing to do
        return

    # Prevent migration for already enabled TLS
    if config.exists(base + ['tls']):
        return

    url = config.return_value(url_path)
    if url.lower().startswith('https://'):
        config.set(base + ['tls', 'insecure'])
