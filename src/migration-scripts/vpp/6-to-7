# T9312: VPP sFlow can only be enabled on physical interfaces bound to VPP via
# 'vpp settings interface'. Remove sFlow from any interface that is not a
# physical interface, and delete the 'vpp sflow' node if no valid interface
# remains

from vyos.configtree import ConfigTree


base = ['vpp', 'sflow']
iface_path = base + ['interface']
settings_iface_path = ['vpp', 'settings', 'interface']


def migrate(config: ConfigTree) -> None:
    if not config.exists(iface_path):
        return

    physical_ifaces = (
        config.list_nodes(settings_iface_path)
        if config.exists(settings_iface_path)
        else []
    )

    for iface in config.return_values(iface_path):
        if iface not in physical_ifaces:
            config.delete_value(iface_path, iface)

    # sFlow requires at least one interface; without one the node is invalid,
    # so drop the whole 'vpp sflow' configuration.
    if not config.exists(iface_path):
        config.delete(base)
