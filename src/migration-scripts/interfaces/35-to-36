#
# T6513: rename "security wpa passphrase" to "security wpa password". A WPA
# username is only used in station mode - it was silently ignored otherwise and
# is now rejected, so drop it.

from vyos.configtree import ConfigTree

base = ['interfaces', 'wireless']

def migrate(config: ConfigTree) -> None:
    if not config.exists(base):
        return

    for wlan in config.list_nodes(base):
        wpa_path = base + [wlan, 'security', 'wpa']
        if not config.exists(wpa_path):
            continue

        if config.exists(wpa_path + ['passphrase']):
            config.rename(wpa_path + ['passphrase'], 'password')

        type_path = base + [wlan, 'type']
        is_station = config.exists(type_path) and config.return_value(type_path) == 'station'
        if not is_station and config.exists(wpa_path + ['username']):
            config.delete(wpa_path + ['username'])
