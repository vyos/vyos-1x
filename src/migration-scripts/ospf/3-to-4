# T9606: "parameters rfc1583-compatibility" moves to "compatible rfc1583",
#        matching FRR's "compatible" command family.

from vyos.configtree import ConfigTree


def compatible_migration(config: ConfigTree, ospf_base: list) -> None:
    if not config.exists(ospf_base):
        return

    parameters = ospf_base + ['parameters']
    if config.exists(parameters + ['rfc1583-compatibility']):
        config.delete(parameters + ['rfc1583-compatibility'])

        # do not leave an empty "parameters" node behind
        if config.list_nodes(parameters) == []:
            config.delete(parameters)

        config.set(ospf_base + ['compatible', 'rfc1583'])


def migrate(config: ConfigTree) -> None:
    # OSPF in the default VRF
    compatible_migration(config, ['protocols', 'ospf'])

    # OSPF in every VRF
    if config.exists(['vrf', 'name']):
        for name in config.list_nodes(['vrf', 'name']):
            compatible_migration(config, ['vrf', 'name', name, 'protocols', 'ospf'])
