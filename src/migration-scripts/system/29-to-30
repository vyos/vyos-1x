# T7557: OpenSSH does not support DSA keys in Debian Trixie

from vyos.configtree import ConfigTree

base = ['system', 'login', 'user']

def migrate(config: ConfigTree) -> None:
    if not config.exists(base):
        return

    for user in config.list_nodes(base):
        key_base = base + [user, 'authentication', 'public-keys']
        if config.exists(key_base):
            for key in config.list_nodes(key_base):
                key_type = key_base + [key, 'type']
                if config.exists(key_type):
                    tmp = config.return_value(key_type)
                    if tmp == 'ssh-dss':
                        config.delete(key_base + [key])
