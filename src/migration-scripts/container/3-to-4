# T9592: preserve the effective network type before stricter validation.

from vyos.configtree import ConfigTree


def migrate(config: ConfigTree) -> None:
    base = ['container', 'network']
    if not config.exists(base):
        return

    for name in config.list_nodes(base):
        macvlan = base + [name, 'type', 'macvlan']
        bridge = base + [name, 'type', 'bridge']
        if not config.exists(macvlan):
            continue

        # An empty MACVLAN node previously selected the managed bridge driver.
        if not config.list_nodes(macvlan) and not config.return_values(macvlan):
            config.delete(macvlan)
            if not config.exists(bridge):
                config.set(bridge)
        elif config.exists(bridge):
            # Configured MACVLAN took precedence when both types were present.
            config.delete(bridge)
