# Tag every AM64x CPSW port netdev with its DT-declared physical port
# number (from of_node/reg).  The .link files in /etc/systemd/network/
# match on this property to map physical port -> ethN deterministically,
# without depending on MAC, kernel enumeration order, or the systemd
# predictable-name scheme.
#
# Runs before 62-temporary-interface-rename.rules and well before
# 80-net-setup-link.rules, so the property is visible when systemd-udevd
# evaluates the .link [Match] block.

ACTION!="add",                              GOTO="igos_cpsw_end"
SUBSYSTEM!="net",                           GOTO="igos_cpsw_end"
DRIVERS!="am65-cpsw-nuss",                  GOTO="igos_cpsw_end"

PROGRAM="/usr/lib/udev/igos-cpsw-port-id %p", ENV{IGOS_CPSW_PORT}="%c"

LABEL="igos_cpsw_end"
