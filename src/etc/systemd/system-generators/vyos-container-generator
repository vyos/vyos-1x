import sys
from configparser import ConfigParser
from pathlib import Path


def generate(output):
    for quadlet in Path('/run/containers/systemd').glob('vyos-container-*.container'):
        config = ConfigParser(interpolation=None, strict=False)
        config.read(quadlet)
        bridge = config.get('X-VyOS', 'BridgeInterface', fallback=None)
        if bridge is None:
            continue
        network = config.get('Container', 'Network').split(':', 1)[0].removesuffix('.network')
        container = f'{quadlet.stem}.service'
        recovery = f'vyos-container-bridge-recovery@{quadlet.stem}.service'
        device = f'sys-subsystem-net-devices-{bridge}.device'
        # Wait for teardown before restarting: a device can return while its
        # previous network/container stop jobs are still pending.
        (output / recovery).write_text(
            '[Unit]\n'
            f'Description=Recover {container} after bridge recreation\n'
            f'After={device} {network}-network.service {container}\n'
            f'ConditionPathExists=/sys/class/net/{bridge}\n'
            f'ConditionPathExists={quadlet}\n'
            '[Service]\n'
            'Type=oneshot\n'
            f'ExecStart=/usr/bin/systemctl --no-block restart {container}\n')
        wants = output / f'{device}.wants'
        wants.mkdir(exist_ok=True)
        (wants / recovery).symlink_to(f'../{recovery}')


if __name__ == '__main__':
    generate(Path(sys.argv[1]))
