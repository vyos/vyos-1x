[Unit]
Description=iGOS WWAN Interface Manager
Documentation=man:igos-wwan-manager(8)
# IMPORTANT: do NOT Wants=/Requires= ModemManager.service.
#
# Pulling MM in alongside us starts it in parallel with our After=
# systemd-udev-settle gate, which races: MM enumerates the modem's
# usb_device (e.g. /sys/bus/usb/devices/1-1) BEFORE 60-Perle-usb-modem
# .rules has stamped ID_MM_PHYSDEV_UID on it, then caches the modem
# object with no UID forever (it does not re-read the udev db).
#
# Symptoms when racing: `mmcli -m 0` shows no `modem.generic.device.uid`
# line, and only restarting MM by hand (after udev has long since
# settled) makes the UID appear.
#
# We talk to MM over D-Bus, so dbus-daemon will auto-activate MM on the
# first call from our manager -- by then systemd-udev-settle.service
# (which WE wait on) has long completed, so coldplug rules have run and
# the UID is already in the udev db when MM enumerates.
#
# After=ModemManager.service is harmless and only orders us *if* MM is
# already up; it does not pull MM in.
After=systemd-udev-settle.service dbus.service ModemManager.service vyos-router.service
Wants=systemd-udev-settle.service dbus.service
# Note: Optional service - does not block VyOS boot if it fails

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/python3/dist-packages/vyos/utils/wwan/interfaces_wwan_main.py
Restart=on-failure
RestartSec=30
StartLimitBurst=3
StartLimitIntervalSec=300
User=root
Group=vyattacfg

# Security settings
# Note: This service must configure network interfaces (ip addr/route/link),
# write sysctl (/proc/sys/net/) and sysfs (/sys/class/net/) values, and
# read the VyOS config tree.  Heavy sandboxing is not feasible.
ProtectHome=read-only
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
RemoveIPC=true

# Allow D-Bus communication
SupplementaryGroups=messagebus

# Environment
Environment=PYTHONPATH=/usr/lib/python3/dist-packages
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONUNBUFFERED=1

# Logging
SyslogIdentifier=igos-wwan-manager
StandardOutput=journal
StandardError=journal
SyslogIdentifier=igos-wwan-manager

[Install]
WantedBy=multi-user.target
