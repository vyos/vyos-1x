# Shared RFC3442 classless-route (option 121) decoder for VyOS dhclient
# hooks. Source this file; do not put it in *-hooks.d (that directory is
# auto-run). Truncated, unknown, or out-of-range octets return 1.
#
# _rfc3442_walk "$encoded" callback
#   callback is invoked as: callback <len> <net> <gw>
#   Used by 01-vyos-cleanup, 02-vyos-dhcp-renew-rfc3442, and
#   04-vyos-dhcp-renew-default-route.

_rfc3442_octet_ok() {
    case $1 in
        [0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) ;;
        *) return 1 ;;
    esac
}

_rfc3442_octets_ok() {
    n=$1
    shift
    while [ "$n" -gt 0 ]; do
        _rfc3442_octet_ok "$1" || return 1
        shift
        n=$((n - 1))
    done
}

_rfc3442_walk() {
    _rfc3442_cb=$2
    set -- $1
    while [ $# -gt 0 ]; do
        rfc3442_len=$1
        case $rfc3442_len in
            32|31|30|29|28|27|26|25)
                if [ $# -lt 9 ]; then
                    return 1
                fi
                _rfc3442_octets_ok 8 "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9" \
                    || return 1
                rfc3442_net="${2}.${3}.${4}.${5}"
                rfc3442_gw="${6}.${7}.${8}.${9}"
                shift 9
                ;;
            24|23|22|21|20|19|18|17)
                if [ $# -lt 8 ]; then
                    return 1
                fi
                _rfc3442_octets_ok 7 "$2" "$3" "$4" "$5" "$6" "$7" "$8" \
                    || return 1
                rfc3442_net="${2}.${3}.${4}.0"
                rfc3442_gw="${5}.${6}.${7}.${8}"
                shift 8
                ;;
            16|15|14|13|12|11|10|9)
                if [ $# -lt 7 ]; then
                    return 1
                fi
                _rfc3442_octets_ok 6 "$2" "$3" "$4" "$5" "$6" "$7" || return 1
                rfc3442_net="${2}.${3}.0.0"
                rfc3442_gw="${4}.${5}.${6}.${7}"
                shift 7
                ;;
            8|7|6|5|4|3|2|1)
                if [ $# -lt 6 ]; then
                    return 1
                fi
                _rfc3442_octets_ok 5 "$2" "$3" "$4" "$5" "$6" || return 1
                rfc3442_net="${2}.0.0.0"
                rfc3442_gw="${3}.${4}.${5}.${6}"
                shift 6
                ;;
            0)
                if [ $# -lt 5 ]; then
                    return 1
                fi
                _rfc3442_octets_ok 4 "$2" "$3" "$4" "$5" || return 1
                rfc3442_net="0.0.0.0"
                rfc3442_gw="${2}.${3}.${4}.${5}"
                shift 5
                ;;
            *)
                return 1
                ;;
        esac
        "$_rfc3442_cb" "$rfc3442_len" "$rfc3442_net" "$rfc3442_gw" || return 1
    done
}
