#!/usr/bin/env python3
import sys
import re
import glob


def main():
    devpath = sys.argv[1] if len(sys.argv) > 1 else ""
    if "/net/" not in devpath:
        return 1

    parts = devpath.split(".usb")
    if len(parts) != 2:
        return 1

    devpath_parent = parts[0] + ".usb"
    devpath_child = parts[1]

    port = "0-0"
    for part in devpath_child.split("/"):
        if re.fullmatch(r"\d+-[\d.]+", part):
            port = part

    key = f"{devpath_parent}#{port}"

    property_key = f"Property=IGOS_WWAN_PORT={key}"
    for lf in sorted(glob.glob("/etc/systemd/network/10-igos-*.link")):
        try:
            with open(lf) as f:
                for line in f:
                    if line.strip() == property_key:
                        print(f"IGOS_WWAN_PORT={key}")
                        return 0
        except OSError:
            continue

    return 0


if __name__ == "__main__":
    sys.exit(main())
