#!/usr/bin/env python3
import sys
import re


def main():
    devpath = sys.argv[1] if len(sys.argv) > 1 else ""
    if "/net/" not in devpath:
        return 1

    parts = devpath.split(".usb")
    if len(parts) != 2:
        return 1

    devpath_parent = parts[0] + ".usb"
    devpath_child = parts[1]

    port = "0-0"
    for part in devpath_child.split("/"):
        if re.fullmatch(r"\d+-[\d.]+", part):
            port = part

    key = f"{devpath_parent}#{port}"

    try:
        with open("/usr/lib/igos/interfaces.conf") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split("=", 1)
                if len(parts) != 2:
                    continue
                if parts[0] == key:
                    print(f'IGOS_WWAN_PORT={key}')
                    print(f'IGOS_IFNAME={parts[1]}')
                    return 0
    except OSError:
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
