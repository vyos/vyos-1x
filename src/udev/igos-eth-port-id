#!/usr/bin/env python3
"""Generic per-physical-port id for any ethN netdev.

Emits a line of the form:
  IGOS_ETH_PORT=<parent-devpath>#<port-number>
on stdout when a stable physical-socket identifier can be derived,
and exits 0.  On any failure prints nothing and exits non-zero.

Input:
  sys.argv[1] : udev devpath (use "%p" in the rule's IMPORT{program}=).
"""

import glob
import os
import sys


def main():
    devpath = sys.argv[1] if len(sys.argv) > 1 else ""

    if "/net/" not in devpath:
        return 1

    parts = devpath.rsplit("/net/", 1)
    if len(parts) != 2:
        return 1
    parent, ifname = parts
    if not parent or not ifname:
        return 1

    port = None

    # ---------- 1. device-tree local-mac-address match -------------------
    try:
        mac = open(f"/sys/class/net/{ifname}/address").read().strip()
    except OSError:
        mac = ""

    if mac:
        mac_hex = mac.replace(":", "").lower()
        ports_dir = f"/sys/class/net/{ifname}/device/of_node/ethernet-ports"
        if os.path.isdir(ports_dir):
            for p in sorted(glob.glob(os.path.join(ports_dir, "port@*"))):
                if not os.path.isdir(p):
                    continue
                macfile = os.path.join(p, "local-mac-address")
                if not os.path.isfile(macfile):
                    continue
                try:
                    with open(macfile, "rb") as f:
                        raw = f.read(6)
                    p_hex = raw.hex()
                except OSError:
                    continue
                if p_hex == mac_hex:
                    hex_str = os.path.basename(p).split("port@", 1)[1]
                    try:
                        port = int(hex_str, 16)
                    except ValueError:
                        port = None
                    break

    # ---------- 2. fall back to kernel dev_port --------------------------
    if port is None:
        try:
            val = open(f"/sys{devpath}/dev_port").read().strip()
            port = int(val)
        except (OSError, ValueError):
            port = 0

    key = f"{parent}#{port}"

    try:
        with open("/usr/lib/igos/interfaces.conf") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split("=", 1)
                if len(parts) != 2:
                    continue
                if parts[0] == key:
                    target_name = parts[1]
                    print(f'IGOS_ETH_PORT={key}')
                    print(f'IGOS_IFNAME={target_name}')
                    # Write rescan hint so vyos-interface-rescan sees this interface
                    hint_dir = "/run/udev/vyos"
                    os.makedirs(hint_dir, exist_ok=True)
                    try:
                        with open(os.path.join(hint_dir, target_name), "w") as hf:
                            hf.write(mac if mac else "")
                    except OSError:
                        pass
                    return 0
    except OSError:
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
