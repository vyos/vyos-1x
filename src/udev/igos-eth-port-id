#!/bin/sh
# Generic per-physical-port id for any ethN netdev.
#
# Emits a line of the form:
#   IGOS_ETH_PORT=<parent-devpath>#<port-number>
# on stdout when a stable physical-socket identifier can be derived,
# and exits 0.  On any failure prints nothing and exits non-zero, so
# the device falls through to 62-temporary-interface-rename.rules and
# 65-vyos-net.rules (today's hw-id based behaviour) untouched.
#
# port-number resolution order (first hit wins):
#   1. Device-tree match: walk the parent device's of_node/ethernet-ports/
#      port@N nodes and find the one whose local-mac-address equals the
#      netdev's MAC.  This covers multi-port controllers that share a
#      single parent platform device and do NOT populate dev_port -- the
#      TI am65-cpsw-nuss family being the motivating example.  The MAC
#      values in each port@N node are fixed up by u-boot from per-unit
#      EEPROM, so the same physical socket on every board still yields
#      the same DT port index.
#   2. /sys/class/net/<if>/dev_port: the kernel's universal multi-port
#      discriminator for controllers that do populate it (mlx5, bnxt,
#      dual-port igc/ixgbe, etc.).  Defaults to 0 for single-port NICs.
#
# parent-devpath is the netdev's devpath with the trailing "/net/<if>"
# stripped -- stable per physical socket on PCI, USB, and platform
# buses.  Combined with the resolved port number it uniquely identifies
# a physical socket without referencing MAC addresses or driver names
# in the consumer (.link) files.
#
# Input:
#   $1 : udev devpath (use "%p" in the rule's IMPORT{program}=).

set -eu

devpath="${1:-}"
case "$devpath" in
    */net/*) ;;
    *) exit 1 ;;
esac

ifname=${devpath##*/net/}
parent=${devpath%/net/*}
[ -n "$parent" ] && [ -n "$ifname" ] || exit 1

port=""

# ---------- 1. device-tree local-mac-address match -------------------
mac=$(cat "/sys/class/net/${ifname}/address" 2>/dev/null || true)
if [ -n "$mac" ]; then
    mac_hex=$(printf '%s' "$mac" | tr -d :: | tr 'A-F' 'a-f')
    ports_dir="/sys/class/net/${ifname}/device/of_node/ethernet-ports"
    if [ -d "$ports_dir" ]; then
        for p in "$ports_dir"/port@*; do
            [ -d "$p" ] || continue
            macfile="$p/local-mac-address"
            [ -r "$macfile" ] || continue
            p_hex=$(od -An -tx1 -N6 "$macfile" 2>/dev/null \
                    | tr -d ' \n\t' | tr 'A-F' 'a-f')
            if [ "$p_hex" = "$mac_hex" ]; then
                # strip "port@" prefix; reg is hex per DT spec
                hex=${p##*port@}
                port=$(printf '%d' "0x${hex}" 2>/dev/null || echo "")
                break
            fi
        done
    fi
fi

# ---------- 2. fall back to kernel dev_port --------------------------
if [ -z "$port" ]; then
    port=$(cat "/sys${devpath}/dev_port" 2>/dev/null || echo 0)
    case "$port" in
        ''|*[!0-9]*) port=0 ;;
    esac
fi

key="${parent}#${port}"
printf 'IGOS_ETH_PORT=%s\n' "$key"

# ---------- 3. mark interface as pinned iff a .link matches ----------
# Only set IGOS_ETH_PINNED=1 when an installed .link file declares
# Property=IGOS_ETH_PORT=<key>.  This is the signal rules 62 and 65 use
# to skip temp-rename and vyos_net_name (which otherwise drops a hint
# that causes vyos-interface-rescan.py to write hw-id into config.boot).
# Interfaces with no matching .link fall through to the legacy hw-id
# path unchanged.
for lf in /etc/systemd/network/10-igos-*.link; do
    [ -r "$lf" ] || continue
    if grep -qxF "Property=IGOS_ETH_PORT=${key}" "$lf"; then
        printf 'IGOS_ETH_PINNED=1\n'
        break
    fi
done
