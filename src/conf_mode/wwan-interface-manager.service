# WWAN Interface Manager System Service
# Place this file in /etc/systemd/system/
# 
# Installation:
#   sudo cp wwan-interface-manager.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable wwan-interface-manager.service
#   sudo systemctl start wwan-interface-manager.service

[Unit]
Description=WWAN Interface Manager
Documentation=https://your-docs-url.com
After=network.target
Before=network-online.target
Wants=network.target

# Service Configuration
[Service]
Type=exec
ExecStart=/usr/bin/python3 /opt/wwan-manager/interfaces_wwan_main.py
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

# Restart policy
Restart=always
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=10

# Working directory
WorkingDirectory=/opt/wwan-manager

# User and permissions - RUNS AS ROOT for system management
User=root
Group=root

# Security settings (restrict what the service can do)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log /var/run /tmp
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true

# Allow access to system management capabilities
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wwan-manager

# Environment
Environment=PYTHONPATH=/opt/wwan-manager
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target