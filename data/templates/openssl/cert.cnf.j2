### Autogenerated by tpm_pki.py ###

[ req ]
default_bits            = {{ key_bits }}
{% if not is_csr %}
certificate             = {{ cert }}
private_key             = {{ key }}
{% endif %}
distinguished_name      = req_distinguished_name
prompt                  = no

req_extensions          = v3_req

[ req_distinguished_name ]
C                       = {{ country }}
ST                      = {{ state }}
L                       = {{ locality }}
O                       = {{ organization }}
CN                      = {{ common_name }}

[ v3_req ]
{% if not is_csr %}
basicConstraints        = critical, CA:FALSE
keyUsage                = critical, digitalSignature
{%     if cert_type == "server" %}
extendedKeyUsage        = serverAuth
{%     elif cert_type == "client" %}
extendedKeyUsage        = clientAuth
{%     endif %}
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid
{%     if san_list %}
subjectAltName = @alt_names
{%     endif %}
{% endif %}

{% if san_list %}
[ alt_names ]
{%     set counters = namespace(dns=0, ip=0, email=0, uri=0, rid=0, dirname=0, othername=0) %}
{%     for item in san_list.split(',') %}
{%         set key, value = item.split(':', 1) %}
{%         set key_lower = key.strip().lower() %}
{%         set value = value.strip() %}
{%         if key_lower == 'dns' %}
{%             set counters.dns = counters.dns + 1 %}
DNS.{{ counters.dns }} = {{ value }}
{%         elif key_lower in ['ipv4', 'ipv6', 'ip'] %}
{%             set counters.ip = counters.ip + 1 %}
IP.{{ counters.ip }} = {{ value }}
{%         elif key_lower in ['email', 'rfc822'] %}
{%             set counters.email = counters.email + 1 %}
email.{{ counters.email }} = {{ value }}
{%         elif key_lower == 'uri' %}
{%             set counters.uri = counters.uri + 1 %}
URI.{{ counters.uri }} = {{ value }}
{%         elif key_lower == 'rid' %}
{%             set counters.rid = counters.rid + 1 %}
RID.{{ counters.rid }} = {{ value }}
{%         elif key_lower == 'dirname' %}
{%             set counters.dirname = counters.dirname + 1 %}
dirName.{{ counters.dirname }} = {{ value }}
{%         elif key_lower == 'othername' %}
{%             set counters.othername = counters.othername + 1 %}
otherName.{{ counters.othername }} = {{ value }}
{%         else %}
# Unsupported SAN type: {{ key }}
{%         endif %}
{%     endfor %}
{% endif %}
