{# j2lint: disable=single-statement-per-line #}
### Autogenerated by service_dns_forwarding.py ###

{# pdns-recursor 5.x reads YAML only. Strings are quoted, as IPv6 addresses #}
{# and names starting with '!' would not be plain scalars. #}
# Non-configurable defaults
dnssec:
  # dnssec
  validation: "{{ dnssec }}"

{% if options.ecs_add_for is vyos_defined or options.ecs_ipv4_bits is vyos_defined %}
# ecs
ecs:
{%     if options.ecs_add_for is vyos_defined %}
  add_for:
{%         for entry in options.ecs_add_for %}
  - "{{ entry }}"
{%         endfor %}
{%     endif %}
{%     if options.ecs_ipv4_bits is vyos_defined %}
  ipv4_bits: {{ options.ecs_ipv4_bits }}
{%     endif %}

{% endif %}
incoming:
  allow_from:
{% for entry in allow_from %}
  - "{{ entry }}"
{% endfor %}
  # listen-address
  listen:
{% for entry in listen_address %}
  - "{{ entry }}"
{% endfor %}
  non_local_bind: true
  # listen-port
  port: {{ port }}

logging:
  common_errors: true

outgoing:
{% if recursion_exclude_address is vyos_defined %}
  # dont-query: a YAML list replaces the default list of the recursor, so
  # the default list is repeated here and the configured entries are appended
  dont_query:
{%     for entry in ['127.0.0.0/8', '10.0.0.0/8', '100.64.0.0/10', '169.254.0.0/16', '192.168.0.0/16', '172.16.0.0/12', '::1/128', 'fc00::/7', 'fe80::/10', '0.0.0.0/8', '192.0.0.0/24', '192.0.2.0/24', '198.51.100.0/24', '203.0.113.0/24', '240.0.0.0/4', '::/96', '::ffff:0:0/96', '100::/64', '2001:db8::/32'] %}
  - "{{ entry }}"
{%     endfor %}
{%     for entry in recursion_exclude_address %}
  - "{{ entry }}"
{%     endfor %}
{% endif %}
{% if exclude_throttle_address is vyos_defined %}
  # dont-throttle-netmasks
  dont_throttle_netmasks:
{%     for entry in exclude_throttle_address %}
  - "{{ entry }}"
{%     endfor %}
{% endif %}
{% if options.edns_subnet_allow_list is vyos_defined %}
  edns_subnet_allow_list:
{%     for entry in options.edns_subnet_allow_list %}
  - "{{ entry }}"
{%     endfor %}
{% endif %}
  # timeout
  network_timeout: {{ timeout }}
  source_address:
{% for entry in source_address %}
  - "{{ entry }}"
{% endfor %}

recordcache:
  # cache-size
  max_entries: {{ cache_size }}
  # negative TTL for NXDOMAIN
  max_negative_ttl: {{ negative_ttl }}
  # TTL refresh percentage
  refresh_on_ttl_perc: {{ ttl_percent }}
{% if serve_stale_extension is vyos_defined %}
  # serve-stale-extensions
  serve_stale_extensions: {{ serve_stale_extension }}
{% endif %}

recursor:
  # zones
{% if authoritative_zones is vyos_defined and authoritative_zones %}
  auth_zones:
{%     for z in authoritative_zones %}
  - zone: "{{ z.name }}"
    file: "{{ z.file }}"
{%     endfor %}
{% else %}
  auth_zones: []
{% endif %}
{% if dns64_prefix is vyos_defined %}
  # dns64-prefix
  dns64_prefix: "{{ dns64_prefix }}"
{% endif %}
  # ignore-hosts-file
  export_etc_hosts: {{ 'false' if ignore_hosts_file is vyos_defined else 'true' }}
  forward_zones_file: {{ config_dir }}/recursor.forward-zones.yml
  lua_config_file: {{ config_dir }}/recursor.conf.lua
  # minimum-ttl-override
  minimum_ttl_override: {{ minimum_ttl_override }}
  # nothing-below-nxdomain
  nothing_below_nxdomain: "{{ nothing_below_nxdomain }}"
  # security-poll-suffix: unset (the VyOS default) disables the periodic
  # security status poll, since VyOS ships a patched/backported package that
  # is never updated in place and the poll result is thus meaningless (T9175)
  security_poll_suffix: "{{ options.security_status_poll_domain if options.security_status_poll_domain is vyos_defined else '' }}"
  # serve rfc1918 records
  serve_rfc1918: {{ 'false' if no_serve_rfc1918 is vyos_defined else 'true' }}
  threads: 1
