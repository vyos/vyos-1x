#!/bin/sh
### Autogenerated by interface.py ###
# Update DNS information for DHCPv6 clients
# should be used only if vyos-hostsd is running

LOG_ENABLE="yes"
LOG_STDERR="no"
LOG_TAG="dhcpcd6-script-vyos"

logmsg () {
    _lvl="$1"; shift
    case "$_lvl" in
        error) _prio="daemon.err" ;;
        info)  _prio="daemon.info" ;;
        *)     _prio="daemon.info" ;;
    esac
    [ "${LOG_ENABLE}" = "yes" ] || return 0
    if [ "${LOG_STDERR}" = "yes" ]; then
        /usr/bin/logger -e --id=$$ -s -p "${_prio}" -t "${LOG_TAG}" "$@"
    else
        /usr/bin/logger -e --id=$$ -p "${_prio}" -t "${LOG_TAG}" "$@"
    fi
}

if /usr/bin/systemctl -q is-active vyos-hostsd; then
    hostsd_client="/usr/bin/vyos-hostsd-client"
    hostsd_changes=

    if [ -n "$new_dhcp6_domain_search" ]; then
        logmsg info "Deleting search domains with tag \"dhcpv6-{{ ifname }}\" via vyos-hostsd-client"
        $hostsd_client --delete-search-domains --tag "dhcpv6-{{ ifname }}"
        logmsg info "Adding domain name \"$new_dhcp6_domain_search\" as search domain with tag \"dhcpv6-{{ ifname }}\" via vyos-hostsd-client"
        $hostsd_client --add-search-domains $new_dhcp6_domain_search --tag "dhcpv6-{{ ifname }}"
        hostsd_changes=y
    fi

    if [ -n "$new_dhcp6_name_servers" ]; then
        logmsg info "Deleting nameservers with tag \"dhcpv6-{{ ifname }}\" via vyos-hostsd-client"
        $hostsd_client --delete-name-servers --tag "dhcpv6-{{ ifname }}"
        logmsg info "Adding nameservers \"$new_dhcp6_name_servers\" with tag \"dhcpv6-{{ ifname }}\" via vyos-hostsd-client"
        $hostsd_client --add-name-servers $new_dhcp6_name_servers --tag "dhcpv6-{{ ifname }}"
        hostsd_changes=y
    fi

    if [ $hostsd_changes ]; then
        logmsg info "Applying changes via vyos-hostsd-client"
        $hostsd_client --apply
    else
        logmsg info "No changes to apply via vyos-hostsd-client"
    fi
fi
