# Generated by VyOS. Do not edit.

# Devices gpsd should connect to at boot time.
# They need to be read/writeable, either by user gpsd or the group dialout.
DEVICES="{{ source | join(' ') }}"

# Other options you want to pass to gpsd
GPSD_OPTIONS="{{ ( '-b ' if read_only is vyos_defined else '' ) ~
( '-D %s ' % debug if debug else '' ) ~
( '-f %s ' % framing if framing else '' ) ~
( '-G ' if listen_any is vyos_defined else '' ) ~
( '-n ' if no_wait is vyos_defined else '' ) ~
( '-r ' if bad_time is vyos_defined else '' ) ~
( '-S %s ' % port if port else '' ) ~
( '-s %s ' % speed if speed else '' ) }}"

# Automatically hot add/remove USB GPS devices via gpsdctl
USBAUTO="{{ 'false' if disable_usb_auto is vyos_defined else 'true' }}"