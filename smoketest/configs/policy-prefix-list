interfaces {
    ethernet eth0 {
        address dhcp
    }
    ethernet eth1 {
        address 192.168.0.1/24
        speed auto
        duplex auto
    }
    ethernet eth2 {
        speed auto
        duplex auto
    }
    loopback lo {
    }
}
policy {
    prefix-list 198.51.100.0-24 {
        description "IP prefix used as name"
        rule 10 {
            action permit
            ge 25
            le 28
            prefix 198.51.100.0/24
        }
    }
    prefix-list 203.0.113.249-EXPORT {
        description "prefixes list"
        rule 10 {
            action permit
            prefix 203.0.113.0/26
        }
        rule 20 {
            action permit
            prefix 203.0.113.64/26
        }
        rule 30 {
            action deny
            prefix 203.0.113.128/25
        }
    }
    prefix-list 203_0_113_249-EXPORT {
        rule 10 {
            action deny
            prefix 192.0.2.0/24
        }
    }
    prefix-list AS65002.IN {
        rule 10 {
            action permit
            prefix 198.51.100.0/25
        }
    }
    prefix-list KEEP-me_1 {
        description "valid name - must not be touched"
        rule 10 {
            action permit
            prefix 198.51.100.128/25
        }
    }
    prefix-list a..b {
        description "consecutive dots"
        rule 10 {
            action permit
            prefix 203.0.113.0/25
        }
    }
    prefix-list dual.name {
        description "IPv4 twin - collides with dual_name"
        rule 10 {
            action permit
            prefix 192.0.2.0/25
        }
    }
    prefix-list dual_name {
        rule 10 {
            action deny
            prefix 192.0.2.128/25
        }
    }
    prefix-list p.q.r {
        rule 10 {
            action permit
            prefix 192.0.2.0/26
        }
    }
    prefix-list p.q_r {
        rule 10 {
            action permit
            prefix 192.0.2.64/26
        }
    }
    prefix-list p_q.r {
        rule 10 {
            action permit
            prefix 192.0.2.128/26
        }
    }
    prefix-list x.y {
        rule 10 {
            action permit
            prefix 198.51.100.0/26
        }
    }
    prefix-list x_y {
        rule 10 {
            action permit
            prefix 198.51.100.64/26
        }
    }
    prefix-list x_y_1 {
        rule 10 {
            action permit
            prefix 198.51.100.128/26
        }
    }
    prefix-list6 2001.db8.ext {
        rule 10 {
            action permit
            prefix 2001:db8:e::/48
        }
    }
    prefix-list6 KEEP6 {
        rule 10 {
            action permit
            prefix 2001:db8:6::/48
        }
    }
    prefix-list6 dual.name {
        description "IPv6 twin - no collision in the IPv6 namespace"
        rule 10 {
            action permit
            prefix 2001:db8:d::/48
        }
    }
    prefix-list6 p6.x {
        rule 10 {
            action permit
            ge 56
            le 64
            prefix 2001:db8:3::/48
        }
    }
    prefix-list6 p6_x {
        rule 10 {
            action deny
            prefix 2001:db8:4::/48
        }
    }
    prefix-list6 v6.list {
        rule 10 {
            action permit
            prefix 2001:db8:1::/48
        }
    }
    route-map RM-IN {
        rule 10 {
            action permit
            match {
                ip {
                    address {
                        prefix-list 203.0.113.249-EXPORT
                    }
                }
            }
        }
        rule 20 {
            action permit
            match {
                ip {
                    nexthop {
                        prefix-list AS65002.IN
                    }
                }
            }
        }
        rule 30 {
            action permit
            match {
                ip {
                    route-source {
                        prefix-list a..b
                    }
                }
            }
        }
        rule 40 {
            action permit
            match {
                ipv6 {
                    address {
                        prefix-list v6.list
                    }
                }
            }
        }
        rule 50 {
            action permit
            match {
                ip {
                    address {
                        prefix-list p.q.r
                    }
                }
            }
        }
        rule 60 {
            action permit
            match {
                ip {
                    nexthop {
                        prefix-list p.q_r
                    }
                }
            }
        }
        rule 70 {
            action permit
            match {
                ip {
                    route-source {
                        prefix-list p_q.r
                    }
                }
            }
        }
        rule 80 {
            action permit
            match {
                ip {
                    address {
                        prefix-list x.y
                    }
                }
            }
        }
        rule 90 {
            action permit
            match {
                ip {
                    address {
                        prefix-list dual.name
                    }
                }
            }
        }
        rule 100 {
            action permit
            match {
                ipv6 {
                    address {
                        prefix-list dual.name
                    }
                }
            }
        }
        rule 110 {
            action permit
            match {
                ipv6 {
                    address {
                        prefix-list p6.x
                    }
                }
            }
        }
        rule 120 {
            action deny
            match {
                ip {
                    address {
                        prefix-list 198.51.100.0-24
                    }
                }
            }
        }
    }
    route-map RM-OUT {
        rule 10 {
            action permit
            match {
                ip {
                    address {
                        prefix-list KEEP-me_1
                    }
                }
            }
        }
        rule 20 {
            action permit
            match {
                ip {
                    nexthop {
                        prefix-list x_y
                    }
                }
            }
        }
        rule 30 {
            action permit
            match {
                ipv6 {
                    address {
                        prefix-list KEEP6
                    }
                }
            }
        }
        rule 40 {
            action permit
            match {
                ipv6 {
                    address {
                        prefix-list 2001.db8.ext
                    }
                }
            }
        }
        rule 50 {
            action permit
            match {
                ip {
                    route-source {
                        prefix-list 203_0_113_249-EXPORT
                    }
                }
            }
        }
    }
}
protocols {
    bgp 65001 {
        neighbor 192.0.2.2 {
            address-family {
                ipv4-unicast {
                    prefix-list {
                        export 203.0.113.249-EXPORT
                        import AS65002.IN
                    }
                }
            }
            remote-as 65002
        }
        neighbor 192.0.2.3 {
            peer-group PG4
        }
        neighbor 192.0.2.4 {
            address-family {
                ipv4-unicast {
                    prefix-list {
                        export KEEP-me_1
                        import x.y
                    }
                }
            }
            remote-as 65004
        }
        neighbor 2001:db8::2 {
            address-family {
                ipv6-unicast {
                    prefix-list {
                        export v6.list
                        import 2001.db8.ext
                    }
                }
            }
            remote-as 65002
        }
        neighbor 2001:db8::3 {
            address-family {
                ipv6-unicast {
                    peer-group PG6
                }
            }
        }
        neighbor 2001:db8::4 {
            address-family {
                ipv6-unicast {
                    prefix-list {
                        export KEEP6
                        import p6.x
                    }
                }
            }
            remote-as 65004
        }
        neighbor 2001:db8::5 {
            address-family {
                ipv4-unicast {
                    prefix-list {
                        export p_q.r
                        import p.q_r
                    }
                }
                ipv6-unicast {
                    prefix-list {
                        export dual.name
                        import dual.name
                    }
                }
            }
            remote-as 65005
        }
        parameters {
            default {
                no-ipv4-unicast
            }
            router-id 192.0.2.1
        }
        peer-group PG4 {
            address-family {
                ipv4-unicast {
                    prefix-list {
                        export p.q.r
                        import dual.name
                    }
                }
            }
            remote-as 65010
        }
        peer-group PG6 {
            address-family {
                ipv6-unicast {
                    prefix-list {
                        export 2001.db8.ext
                        import p6.x
                    }
                }
            }
            remote-as 65020
        }
    }
    rip {
        distribute-list {
            interface eth1 {
                prefix-list {
                    in AS65002.IN
                    out a..b
                }
            }
            interface eth2 {
                prefix-list {
                    out p.q.r
                }
            }
            prefix-list {
                in 203.0.113.249-EXPORT
                out x.y
            }
        }
        network 192.0.2.0/25
    }
    ripng {
        distribute-list {
            interface eth1 {
                prefix-list {
                    out 2001.db8.ext
                }
            }
            interface eth2 {
                prefix-list {
                    in p6.x
                    out dual.name
                }
            }
            prefix-list {
                in KEEP6
                out v6.list
            }
        }
        network 2001:db8::/64
    }
}
service {
    ssh {
    }
}
