firewall {
    group {
        network-group TEST_GROUP, {
            network 192.168.0.0/24
        }
        network-group TEST_GROUP+ {
            network 192.168.1.0/24
        }
    }
    name TEST1 {
        default-action drop
        rule 10 {
            action accept
            source {
                group {
                    network-group TEST_GROUP,
                }
            }
        }
        rule 20 {
            action drop
            source {
                group {
                    network-group !TEST_GROUP,
                }
            }
        }
    }
    name TEST2 {
        default-action drop
        rule 10 {
            action accept
            source {
                group {
                    network-group TEST_GROUP+
                }
            }
        }
        rule 20 {
            action drop
            source {
                group {
                    network-group !TEST_GROUP+
                }
            }
        }
    }
}
interfaces {
    ethernet eth0 {
    }
    loopback lo {
    }
}
system {
    console {
        device ttyS0 {
            speed 115200
        }
    }
    host-name vyos
    login {
