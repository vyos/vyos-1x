interfaces {
    bonding bond10 {
        vif 100 {
        }
    }
    ethernet eth0 {
        duplex auto
        mirror {
            egress tun10
            ingress tun10
        }
        speed auto
        vif 201 {
            address 198.51.100.1/24
            mirror {
                egress bond10.100
                ingress bond10.100
            }
        }
        vif 202 {
            address 203.0.113.1/24
            redirect tun20
        }
    }
    loopback lo {
    }
    tunnel tun10 {
        encapsulation gre
        remote 192.0.2.10
        source-address 198.51.100.1
    }
    tunnel tun20 {
        encapsulation gre
        remote 192.0.2.20
        source-address 203.0.113.1
    }
}
