<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="system">
        <properties>
          <help>Show system information</help>
        </properties>
        <children>
          <node name="tpm">
            <properties>
              <help>Show TPM Hardware support and operational status</help>
            </properties>
            <command>${vyos_op_scripts_dir}/show_tpm.py</command>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
