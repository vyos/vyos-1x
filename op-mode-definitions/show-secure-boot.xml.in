<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="secure-boot">
        <properties>
          <help>Show Secure Boot state</help>
        </properties>
        <command>${vyos_op_scripts_dir}/secure_boot.py show</command>
        <children>
          <leafNode name="detail">
            <properties>
              <help>Show Linux Kernel signature certificate issuer and subject</help>
            </properties>
            <command>${vyos_op_scripts_dir}/secure_boot.py show_detail</command>
          </leafNode>
          <leafNode name="keys">
            <properties>
              <help>Show enrolled certificates</help>
            </properties>
            <command>mokutil --list-enrolled</command>
          </leafNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
