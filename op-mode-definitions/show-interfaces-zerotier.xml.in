<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="interfaces">
        <children>
          <node name="zerotier">
            <properties>
              <help>Show ZeroTier interface information</help>
            </properties>
            <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-type=zerotier</command>
            <children>
              <leafNode name="detail">
                <properties>
                  <help>Show detailed ZeroTier interface information</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show --intf-type=zerotier</command>
              </leafNode>
              <virtualTagNode>
                <properties>
                  <help>Show specified ZeroTier interface information</help>
                  <completionHelp>
                    <script>${vyos_completion_dir}/list_interfaces --type zerotier</script>
                  </completionHelp>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show --intf-name="$4" --intf-type=zerotier</command>
                <children>
                  #include <include/show-interface-type-event-log.xml.i>
                </children>
              </virtualTagNode>
            </children>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
