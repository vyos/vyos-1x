<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="interfaces">
        <children>
         <node name="wwan">
            <properties>
              <help>Show Wireless Modem (WWAN) interface information</help>
            </properties>
            <command>${vyos_op_scripts_dir}/interfaces.py show_summary --intf-type=wwan</command>
            <children>
              <leafNode name="detail">
                <properties>
                  <help>Show detailed Wireless Modem (WWAN) interface information</help>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show --intf-type=wwan</command>
              </leafNode>
              <virtualTagNode>
                <properties>
                  <help>Show specified Wireless Wire Area Network (WWAN) interface information</help>
                  <completionHelp>
                    <path>interfaces wwan</path>
                    <script>cd /sys/class/net; ls -d wwan*</script>
                  </completionHelp>
                </properties>
                <command>${vyos_op_scripts_dir}/interfaces.py show --intf-name="$4" --intf-type=wirelessmodem</command>
                <children>
                  <leafNode name="detail">
                    <properties>
                      <help>Show all WWAN modem information</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/show_wwan.py show_detail --interface="$4"</command>
                  </leafNode>
                  <leafNode name="hardware">
                    <properties>
                      <help>Show WWAN modem hardware information</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/show_wwan.py show_hardware --interface="$4"</command>
                  </leafNode>
                  <leafNode name="signal">
                    <properties>
                      <help>Show WWAN RF signal information</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/show_wwan.py show_signal --interface="$4"</command>
                  </leafNode>
                  <leafNode name="sim">
                    <properties>
                      <help>Show WWAN SIM card information</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/show_wwan.py show_sim --interface="$4"</command>
                  </leafNode>
                  <leafNode name="status">
                    <properties>
                      <help>Show WWAN operational status</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/show_wwan.py show_status --interface="$4"</command>
                  </leafNode>
                  <node name="wait-failover-alert">
                    <properties>
                      <help>Wait for next WWAN failover alert</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/show_wwan.py show_wait_failover --interface="$4"</command>
                    <children>
                      <node name="timeout">
                        <properties>
                          <help>Set wait timeout in seconds</help>
                        </properties>
                        <children>
                          <tagNode name="seconds">
                            <properties>
                              <help>Timeout in seconds (1-600)</help>
                              <constraint>
                                <validator name="numeric" argument="--range 1-600"/>
                              </constraint>
                            </properties>
                            <command>${vyos_op_scripts_dir}/show_wwan.py show_wait_failover --interface="$4" --timeout="$7"</command>
                          </tagNode>
                        </children>
                      </node>
                    </children>
                  </node>
                  <node name="monitor-alerts">
                    <properties>
                      <help>Monitor WWAN alerts for a time window</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/show_wwan.py show_monitor_alerts --interface="$4"</command>
                    <children>
                      <node name="timeout">
                        <properties>
                          <help>Set monitor timeout in seconds</help>
                        </properties>
                        <children>
                          <tagNode name="seconds">
                            <properties>
                              <help>Timeout in seconds (1-600)</help>
                              <constraint>
                                <validator name="numeric" argument="--range 1-600"/>
                              </constraint>
                            </properties>
                            <command>${vyos_op_scripts_dir}/show_wwan.py show_monitor_alerts --interface="$4" --timeout="$7"</command>
                          </tagNode>
                        </children>
                      </node>
                      <node name="severity">
                        <properties>
                          <help>Filter by alert severity</help>
                        </properties>
                        <children>
                          <leafNode name="info">
                            <properties><help>Informational alerts</help></properties>
                            <command>${vyos_op_scripts_dir}/show_wwan.py show_monitor_alerts --interface="$4" --severity="info"</command>
                          </leafNode>
                          <leafNode name="warning">
                            <properties><help>Warning alerts</help></properties>
                            <command>${vyos_op_scripts_dir}/show_wwan.py show_monitor_alerts --interface="$4" --severity="warning"</command>
                          </leafNode>
                          <leafNode name="critical">
                            <properties><help>Critical alerts</help></properties>
                            <command>${vyos_op_scripts_dir}/show_wwan.py show_monitor_alerts --interface="$4" --severity="critical"</command>
                          </leafNode>
                        </children>
                      </node>
                      <node name="category">
                        <properties>
                          <help>Filter by alert category</help>
                        </properties>
                        <children>
                          <leafNode name="connectivity">
                            <properties><help>Connectivity alerts</help></properties>
                            <command>${vyos_op_scripts_dir}/show_wwan.py show_monitor_alerts --interface="$4" --category="connectivity"</command>
                          </leafNode>
                          <leafNode name="sim">
                            <properties><help>SIM alerts</help></properties>
                            <command>${vyos_op_scripts_dir}/show_wwan.py show_monitor_alerts --interface="$4" --category="sim"</command>
                          </leafNode>
                          <leafNode name="usage">
                            <properties><help>Usage alerts</help></properties>
                            <command>${vyos_op_scripts_dir}/show_wwan.py show_monitor_alerts --interface="$4" --category="usage"</command>
                          </leafNode>
                        </children>
                      </node>
                    </children>
                  </node>
                  <node name="sms">
                    <properties>
                      <help>Show SMS messages</help>
                    </properties>
                    <command>${vyos_op_scripts_dir}/wwan_sms.py show_sms --interface="$4"</command>
                    <children>
                      <node name="message">
                        <properties>
                          <help>Show a specific SMS message</help>
                        </properties>
                        <children>
                          <virtualTagNode>
                            <properties>
                              <help>Show a specific SMS message by ID</help>
                              <completionHelp>
                                <list>&lt;1-999&gt;</list>
                              </completionHelp>
                            </properties>
                            <command>${vyos_op_scripts_dir}/wwan_sms.py show_sms_message --interface="$4" --message-id="$7"</command>
                          </virtualTagNode>
                        </children>
                      </node>
                      <virtualTagNode>
                        <properties>
                          <help>Show a specific SMS message by ID</help>
                          <completionHelp>
                            <list>&lt;1-999&gt;</list>
                          </completionHelp>
                        </properties>
                        <command>${vyos_op_scripts_dir}/wwan_sms.py show_sms_message --interface="$4" --message-id="$6"</command>
                      </virtualTagNode>
                    </children>
                  </node>
                  #include <include/show-interface-type-event-log.xml.i>
                </children>
              </virtualTagNode>
            </children>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
