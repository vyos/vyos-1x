<?xml version="1.0"?>
<interfaceDefinition>
  <node name="restart">
    <children>
      <node name="serial">
        <properties>
          <help>Restart services on serial ports</help>
        </properties>
        <command>${vyos_op_scripts_dir}/serial.py restart_serial_tty</command>
        <children>
          <tagNode name="device">
            <properties>
              <help>Restart specific TTY device</help>
              <completionHelp>
                <script>${vyos_completion_dir}/list_login_ttys.py</script>
              </completionHelp>
            </properties>
            <command>${vyos_op_scripts_dir}/serial.py restart_serial_tty --device-name-start "$4"</command>
            <children>
              <tagNode name="to">
                <properties>
                  <help>Restart specific TTY device</help>
                  <completionHelp>
                    <script>${vyos_completion_dir}/list_login_ttys.py --greater ${COMP_WORDS[3]}</script>
                  </completionHelp>
                </properties>
                <command>${vyos_op_scripts_dir}/serial.py restart_serial_tty --device-name-start "$4" --device-name-end "$6"</command>
              </tagNode>
            </children>
          </tagNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
