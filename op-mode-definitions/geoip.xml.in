<?xml version="1.0"?>
<interfaceDefinition>
  <node name="update">
    <children>
      <node name="geoip">
        <properties>
          <help>Update GeoIP database and firewall sets</help>
        </properties>
        <command>sudo ${vyos_libexec_dir}/geoip-update.py</command>
      </node>
    </children>
  </node>
</interfaceDefinition>
