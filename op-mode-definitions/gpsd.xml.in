<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="gpsd">
        <properties>
          <help>Show information about GPSD</help>
        </properties>
        <children>
          <node name="status">
            <properties>
              <help>Report the status of the GPSD service from systemctl</help>
            </properties>
            <command>systemctl status gpsd.service</command>
          </node>
          <node name="location">
            <properties>
              <help>Show the current location reported by GPSD</help>
            </properties>
            <command>${vyos_op_scripts_dir}/gpsd.py show_location</command>
          </node>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
