<?xml version="1.0"?>
<interfaceDefinition>
  <node name="show">
    <children>
      <node name="environment">
        <properties>
          <help>Show current system environmental conditions</help>
        </properties>
        <children>
          <leafNode name="sensors">
            <properties>
              <help>Show hardware monitoring results</help>
            </properties>
	          <command>${vyos_op_scripts_dir}/show_sensors.py</command>
          </leafNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
